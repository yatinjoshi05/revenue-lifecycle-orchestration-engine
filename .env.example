# ==============================================================================
# RLOE (Revenue Lifecycle Orchestration Engine) — Environment Template
# All values are safe non-sensitive placeholders.
# ==============================================================================

# Supabase PostgreSQL & REST API Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# n8n Workflow Orchestrator Endpoints
N8N_TENANT_URL=https://your-tenant.app.n8n.cloud
N8N_WORKFLOW_ID=your_n8n_workflow_id
N8N_WEBHOOK_PROD_URL=https://your-tenant.app.n8n.cloud/webhook/v1/revenue-lifecycle-orchestrator
N8N_WEBHOOK_TEST_URL=https://your-tenant.app.n8n.cloud/webhook-test/v1/revenue-lifecycle-orchestrator
N8N_CLAY_CALLBACK_URL=https://your-tenant.app.n8n.cloud/webhook/v1/rloe-clay-callback
N8N_AUTH_HEADER_NAME=Authorization
N8N_AUTH_HEADER_VALUE=your_custom_shared_secret_bearer_token

# Clay Enrichment Webhook Integration
CLAY_API_KEY=your_clay_api_key_here
CLAY_WEBHOOK_URL=https://api.clay.com/v3/sources/webhook/your_webhook_id
CLAY_WEBHOOK_AUTH_HEADER=x-clay-webhook-auth
CLAY_WEBHOOK_AUTH_TOKEN=your_clay_auth_token_here

# LLM Qualification Provider (Anthropic Claude / NVIDIA Nemotron)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_HEADER_NAME=gtm

# HubSpot CRM Integration
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_access_token_here
